{
  "name": "dogedrop",
  "version": "1.0.0",
  "private": true,
  "description": "DogeDrop, a self-custodial Dogecoin and DogecoinVM wallet that runs in the browser and can be embedded on any website.",
  "scripts": {
    "build": "esbuild src/chain.mjs --bundle --format=iife --global-name=DogeChain --outfile=js/doge-chain.js --legal-comments=eof",
    "test": "node --test test/chain.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.2.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
